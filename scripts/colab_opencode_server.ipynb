   "source": [
    "# 🚀 Chefsy AI Studio & OpenCode GPU - Todo en 1 Clic\n",
    "### DeepSeek R1 (8B) + Qwen 2.5 Coder (7B) + Web Chat tipo ChatGPT\n",
    "\n",
    "### ⚡ Instrucciones:\n",
    "1. Verificá que arriba a la derecha diga **Conectado (T4)** o hacé clic en **Conectar**.\n",
    "2. Dale **PLAY a la única celda de abajo** (hace todo solo: instala, descarga los modelos, inicia el chat y crea los enlaces).\n",
    "3. En ~1 minuto verás en pantalla los **links para abrir tu chat web tipo ChatGPT** y para conectar Antigravity."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 🚀 TODO-EN-UNO: Iniciar GPU, descargar DeepSeek + Qwen y abrir Chat Web\n",
    "import os, sys, time, re, subprocess\n",
    "\n",
    "print(\"=\"*65)\n",
    "print(\"1/4 📦 Instalando Ollama, Cloudflare Tunnel y Gradio...\")\n",
    "print(\"=\"*65)\n",
    "!curl -fsSL https://ollama.ai/install.sh | sh > /dev/null 2>&1\n",
    "!wget -q -nc https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 -O cloudflared\n",
    "!chmod +x cloudflared\n",
    "!pip install -q gradio requests\n",
    "\n",
    "print(\"\\n\" + \"=\"*65)\n",
    "print(\"2/4 ⚡ Iniciando motor Ollama en GPU...\")\n",
    "print(\"=\"*65)\n",
    "!pkill -f \"ollama serve\" || true\n",
    "!pkill -f \"cloudflared\" || true\n",
    "time.sleep(2)\n",
    "\n",
    "os.environ[\"OLLAMA_HOST\"] = \"0.0.0.0:11434\"\n",
    "os.environ[\"OLLAMA_ORIGINS\"] = \"*\"\n",
    "subprocess.Popen([\"ollama\", \"serve\"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n",
    "time.sleep(4)\n",
    "\n",
    "print(\"\\n\" + \"=\"*65)\n",
    "print(\"3/4 📥 Descargando / Verificando DeepSeek R1 y Qwen 2.5 Coder...\")\n",
    "print(\"=\"*65)\n",
    "!ollama pull deepseek-r1:8b\n",
    "!ollama pull qwen2.5-coder:7b\n",
    "\n",
    "print(\"\\n\" + \"=\"*65)\n",
    "print(\"4/4 🚀 Levantando túneles seguros y Web Chat...\")\n",
    "print(\"=\"*65)\n",
    "\n",
    "# Túnel 1: API de Ollama (puerto 11434) para Antigravity\n",
    "!rm -f api_tunnel.log\n",
    "subprocess.Popen([\"./cloudflared\", \"tunnel\", \"--url\", \"http://localhost:11434\"], stdout=open(\"api_tunnel.log\", \"w\"), stderr=subprocess.STDOUT)\n",
    "\n",
    "# Túnel 2: Interfaz Web Gradio (puerto 7860) para chatear en navegador\n",
    "!rm -f chat_tunnel.log\n",
    "subprocess.Popen([\"./cloudflared\", \"tunnel\", \"--url\", \"http://localhost:7860\"], stdout=open(\"chat_tunnel.log\", \"w\"), stderr=subprocess.STDOUT)\n",
    "\n",
    "api_url = None\n",
    "chat_url = None\n",
    "\n",
    "for _ in range(40):\n",
    "    time.sleep(1)\n",
    "    if not api_url and os.path.exists(\"api_tunnel.log\"):\n",
    "        with open(\"api_tunnel.log\", \"r\") as f:\n",
    "            m = re.search(r'https://[a-zA-Z0-9-]+\\.trycloudflare\\.com', f.read())\n",
    "            if m: api_url = m.group(0)\n",
    "    if not chat_url and os.path.exists(\"chat_tunnel.log\"):\n",
    "        with open(\"chat_tunnel.log\", \"r\") as f:\n",
    "            m = re.search(r'https://[a-zA-Z0-9-]+\\.trycloudflare\\.com', f.read())\n",
    "            if m: chat_url = m.group(0)\n",
    "    if api_url and chat_url:\n",
    "        break\n",
    "\n",
    "print(\"\\n\" + \"🎉\"*30)\n",
    "print(\"🟢 ¡SERVIDOR Y CHAT WEB ACTIVOS EN TU GPU!\")\n",
    "print(\"🎉\"*30)\n",
    "if chat_url:\n",
    "    print(f\"\\n👉 1. LINK DE LA PÁGINA WEB PARA CHATEAR (TIPO CHATGPT):\\n   🔗 {chat_url}\\n\")\n",
    "if api_url:\n",
    "    print(f\"👉 2. LINK DE LA API PARA ANTIGRAVITY:\\n   ⚡ {api_url}\\n\")\n",
    "print(\"👉 MODELOS LISTOS: deepseek-r1:8b | qwen2.5-coder:7b\")\n",
    "print(\"=\"*65 + \"\\n\")\n",
    "\n",
    "import gradio as gr\n",
    "import requests, json\n",
    "\n",
    "def stream_chat(message, history, model, temperature):\n",
    "    msgs = []\n",
    "    if history:\n",
    "        for item in history:\n",
    "            if isinstance(item, dict):\n",
    "                msgs.append(item)\n",
    "            elif isinstance(item, (list, tuple)) and len(item) == 2:\n",
    "                msgs.append({\"role\": \"user\", \"content\": str(item[0])})\n",
    "                msgs.append({\"role\": \"assistant\", \"content\": str(item[1])})\n",
    "    msgs.append({\"role\": \"user\", \"content\": str(message)})\n",
    "    \n",
    "    try:\n",
    "        r = requests.post(\n",
    "            \"http://127.0.0.1:11434/api/chat\",\n",
    "            json={\n",
    "                \"model\": model,\n",
    "                \"messages\": msgs,\n",
    "                \"stream\": True,\n",
    "                \"options\": {\"temperature\": float(temperature)}\n",
    "            },\n",
    "            stream=True,\n",
    "            timeout=180\n",
    "        )\n",
    "        acc = ""\n",
    "        for line in r.iter_lines():\n",
    "            if line:\n",
    "                chunk = json.loads(line)\n",
    "                content = chunk.get(\"message\", {}).get(\"content\", \"\")\n",
    "                acc += content\n",
    "                yield acc\n",
    "    except Exception as e:\n",
    "        yield f\"⚠️ Error consultando al modelo: {str(e)}\"\n",
    "\n",
    "with gr.Blocks(theme=gr.themes.Soft(primary_hue=\"emerald\"), title=\"Chefsy AI Studio\") as demo:\n",
    "    gr.Markdown(\"# 🤖 Chefsy AI Studio\")\n",
    "    gr.Markdown(\"Chateá directamente con **DeepSeek R1** y **Qwen 2.5 Coder** alojados en tu GPU T4.\")\n",
    "    with gr.Row():\n",
    "        model_dropdown = gr.Dropdown(\n",
    "            choices=[\"deepseek-r1:8b\", \"qwen2.5-coder:7b\"],\n",
    "            value=\"deepseek-r1:8b\",\n",
    "            label=\"🧠 Modelo de Inteligencia Artificial\"\n",
    "        )\n",
    "        temp_slider = gr.Slider(0.0, 1.0, value=0.3, step=0.05, label=\"🌡️ Creatividad / Temperatura\")\n",
    "    \n",
    "    gr.ChatInterface(\n",
    "        fn=stream_chat,\n",
    "        additional_inputs=[model_dropdown, temp_slider]\n",
    "    )\n",
    "\n",
    "demo.queue().launch(server_name=\"0.0.0.0\", server_port=7860, share=True)\n"
   ]
  }
