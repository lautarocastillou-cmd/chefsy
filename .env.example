# ─────────────────────────────────────────────────────
# .env.example
# Plantilla de variables de entorno para Chefsy.
# ✅ ESTE ARCHIVO SÍ SE SUBE A GITHUB (no contiene secretos).
# ❌ Copiar como .env.local y completar los valores reales.
# ─────────────────────────────────────────────────────

# ── Autenticación y Seguridad ─────────────────────────
# Clave secreta para firmar y verificar tokens JWT (HMAC SHA-256).
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ⚠️  Mínimo 64 caracteres. NUNCA usar el valor de ejemplo en producción.
CHEFSY_JWT_SECRET=reemplazar-por-una-clave-aleatoria-de-64-caracteres-minimo

# Contraseñas de los usuarios del sistema (admin, paulo y cufa)
# ⚠️  Usar contraseñas fuertes en producción. Nunca dejar estos valores en blanco.
CHEFSY_ADMIN_PASS=
CHEFSY_PAULO_PASS=
CHEFSY_CUFA_PASS=


# ── Base de Datos (cuando se migre de localStorage) ───
# Cadena de conexión a la base de datos principal.
# Ejemplos de formato según el motor que se utilice:
#   PostgreSQL: postgresql://usuario:contraseña@host:5432/chefsy
#   MongoDB:    mongodb+srv://usuario:contraseña@cluster.mongodb.net/chefsy
DATABASE_URL=

# ── Supabase (Base de Datos + Realtime) ────────────────
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key-aqui

# ── WhatsApp del Negocio ──────────────────────────────
# Número de teléfono del local (incluyendo código de país y código móvil, ej: 5493815XXXXXX)
NEXT_PUBLIC_WHATSAPP_NEGOCIO=

# ── Servicios Externos (opcionales) ───────────────────
# Clave de API para servicios de mapas si se reemplaza OSRM.
# MAPS_API_KEY=

# Webhook URL para notificaciones internas (ej. Slack, Discord).
# NOTIFICACIONES_WEBHOOK_URL=

# ── Entorno de Ejecución ──────────────────────────────
# Next.js lo detecta automáticamente, pero puede forzarse:
# NODE_ENV=development
