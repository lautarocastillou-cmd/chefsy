# ─────────────────────────────────────────────────────
# .env.example
# Plantilla de variables de entorno para Chefsy.
# ✅ ESTE ARCHIVO SÍ SE SUBE A GITHUB (no contiene secretos).
# ❌ Copiar como .env.local y completar los valores reales.
# ─────────────────────────────────────────────────────

# ── Autenticación y Seguridad ─────────────────────────
# Clave secreta para firmar y verificar tokens JWT (HMAC SHA-256).
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ⚠️  Mínimo 64 caracteres. NUNCA usar el valor de ejemplo en producción.
CHEFSY_JWT_SECRET=reemplazar-por-una-clave-aleatoria-de-64-caracteres-minimo

# ── Contraseñas de acceso (plan B) ──────────────────────
# SOLO se usan si la tabla `usuarios` de la base está vacía o no encuentra
# al usuario. El login intenta primero contra la tabla `usuarios` (contraseña
# hasheada con bcrypt); si falla, cae a este plan B.
#
# ⚠️  La tabla `usuarios` está VACÍA en producción, así que hoy el login
#    depende 100% de estas variables. Si se borran de acá o de .env.local,
#    nadie puede entrar al panel.
#
# Estas dos son las ÚNICAS que el código lee (lib/auth-server.ts):
CHEFSY_ADMIN_PASS=
CHEFSY_CADETE_PASS=

# Las siguientes dos se leían antes en el código pero ya no las usa nadie.
# Se dejan comentadas a propósito para que quede el registro de que existieron.
# Si querés contraseñas separadas por persona, lo que corresponde es crear
# filas en la tabla `usuarios`, no agregar variables nuevas acá.
# CHEFSY_PAULO_PASS=
# CHEFSY_CUFA_PASS=


# ── Base de Datos (cuando se migre de localStorage) ───
# Cadena de conexión a la base de datos principal.
# Ejemplos de formato según el motor que se utilice:
#   PostgreSQL: postgresql://usuario:contraseña@host:5432/chefsy
#   MongoDB:    mongodb+srv://usuario:contraseña@cluster.mongodb.net/chefsy
DATABASE_URL=

# ── Supabase (Base de Datos + Realtime) ────────────────
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key-aqui

# ── WhatsApp del Negocio ──────────────────────────────
# Número de teléfono del local (incluyendo código de país y código móvil, ej: 5493815XXXXXX)
NEXT_PUBLIC_WHATSAPP_NEGOCIO=

# ── Servicios Externos (opcionales) ───────────────────
# Clave de API para servicios de mapas si se reemplaza OSRM.
# MAPS_API_KEY=

# Webhook URL para notificaciones internas (ej. Slack, Discord).
# NOTIFICACIONES_WEBHOOK_URL=

# ── Alertas y Monitoreo a Telegram ────────────────────
# Bot de Telegram para avisar caídas de host y errores silenciosos de usuarios
# 1. Crear bot con @BotFather en Telegram y pegar el token aquí:
TELEGRAM_BOT_TOKEN=
# 2. Tu Chat ID personal o el ID del grupo/canal donde recibirás las alertas (obtener con @userinfobot):
TELEGRAM_CHAT_ID=

# ── Entorno de Ejecución ──────────────────────────────
# Next.js lo detecta automáticamente, pero puede forzarse:
# NODE_ENV=development
